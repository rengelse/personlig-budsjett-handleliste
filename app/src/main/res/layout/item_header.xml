<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerRoot"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_group_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <TextView
        android:id="@+id/headerIcon"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="▣"
        android:textColor="@color/pb_text"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/headerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/pb_text"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/headerCount"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/pb_primary"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/headerTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:textColor="@color/pb_text"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/headerArrow"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="⌃"
        android:textColor="@color/pb_muted"
        android:textSize="16sp"/>
</LinearLayout>
